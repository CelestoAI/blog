---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Card from "@/components/Card.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const prerender = true;

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 4);
const featuredIds = new Set(featuredPosts.map(post => post.id));
const recentPosts = sortedPosts
  .filter(post => !featuredIds.has(post.id))
  .slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <Hero />
    {
      featuredPosts.length > 0 && (
        <section id="featured" aria-labelledby="featured-title">
          <div class="section-heading">
            <>
              <h2 id="featured-title">Featured</h2>
            </>
          </div>
          <div class="featured-grid">
            {featuredPosts.map(post => (
              <FeaturedCard post={post} />
            ))}
          </div>
        </section>
      )
    }
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" aria-labelledby="recent-title">
          <div class="section-heading">
            <>
              <h2 id="recent-title">Latest</h2>
              <a href={`${SITE.basePath}/posts/`}>All posts ↗</a>
            </>
          </div>
          <ul>
            {recentPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
    <section id="topic-results" hidden aria-labelledby="topic-results-title">
      <div class="section-heading">
        <h2 id="topic-results-title">Articles</h2><span
          id="topic-count"
          class="eyebrow"
          role="status"
          aria-live="polite"></span>
      </div>
      <div class="featured-grid">
        {sortedPosts.map(post => <FeaturedCard post={post} />)}
      </div>
    </section>
    <aside class="product-note">
      <div>
        <h2>Celesto documentation</h2><p>
          Set up a cloud computer, connect an agent, and run code.
        </p>
      </div>
      <a href="https://celesto.ai/docs">Read the docs ↗</a>
    </aside>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("keydown", event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      const input =
        document.querySelector<HTMLInputElement>("#blog-search-input");
      if (input) {
        event.preventDefault();
        input.focus();
      }
    }
  });
  function setupTopicFilters() {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/blog/");
      const results = document.querySelector<HTMLElement>("#topic-results");
      const title = document.querySelector("#topic-results-title");
      const count = document.querySelector("#topic-count");
      const topicLinks =
        document.querySelectorAll<HTMLAnchorElement>("[data-blog-topic]");
      topicLinks.forEach(link => {
        link.addEventListener("click", event => {
          if (
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            !results
          )
            return;
          event.preventDefault();
          const topic = link.dataset.blogTopic;
          const all = topic === "all";
          topicLinks.forEach(item =>
            item.setAttribute("aria-current", String(item === link))
          );
          document
            .querySelectorAll<HTMLElement>("#featured, #recent-posts")
            .forEach(section => {
              section.hidden = !all;
            });
          results.hidden = all;
          if (all) return;
          let matches = 0;
          results
            .querySelectorAll<HTMLElement>(".feature-card")
            .forEach(card => {
              const topics: string[] = JSON.parse(card.dataset.topics || "[]");
              card.hidden = !topics.includes(topic || "");
              if (!card.hidden) matches++;
            });
          if (title) title.textContent = link.textContent;
          if (count)
            count.textContent = `${matches} ${matches === 1 ? "article" : "articles"}`;
        });
      });
    }
  }
  setupTopicFilters();
</script>

<style>
  #topic-results[hidden],
  #topic-results :global(.feature-card[hidden]) {
    display: none;
  }
</style>
