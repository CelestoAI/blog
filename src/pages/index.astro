---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Card from "@/components/Card.astro";
import FeaturedCard from "@/components/FeaturedCard.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

export const prerender = true;

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 4);
const featuredIds = new Set(featuredPosts.map(post => post.id));
const recentPosts = sortedPosts
  .filter(post => !featuredIds.has(post.id))
  .slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <Hero />
    {
      featuredPosts.length > 0 && (
        <section id="featured" aria-labelledby="featured-title">
          <div class="section-heading">
            <>
              <h2 id="featured-title">Featured stories</h2>
              <span class="eyebrow">Selected by Celesto</span>
            </>
          </div>
          <div class="featured-grid">
            {featuredPosts.map(post => (
              <FeaturedCard post={post} />
            ))}
          </div>
        </section>
      )
    }
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" aria-labelledby="recent-title">
          <div class="section-heading">
            <>
              <h2 id="recent-title">Latest from the blog</h2>
              <a href={`${SITE.basePath}/posts/`}>All posts ↗</a>
            </>
          </div>
          <ul>
            {recentPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
    <aside class="product-note">
      <div>
        <h2>A real computer for your next agent.</h2><p>
          Run your agent on Celesto. Start with the CLI or explore the docs.
        </p>
      </div>
      <a href="https://celesto.ai/docs">Explore the docs ↗</a>
    </aside>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/blog/");
    }
  });
</script>
