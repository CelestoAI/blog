---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";

export const prerender = true;
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-heading-72 font-semibold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-heading-24 sm:text-heading-32">Page Not Found</p>
      <LinkButton
        href={`${SITE.basePath}/`}
        class="my-6 h-control px-3 text-button-16 underline underline-offset-4"
      >
        Go back home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
