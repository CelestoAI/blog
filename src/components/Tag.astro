---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    class:list={[
      "touch-target relative flex items-center gap-1 rounded-full border border-border px-3 focus-ring",
      "transition-colors hover:border-foreground/40 hover:bg-muted hover:text-accent",
      { "h-control-sm text-label-14": size === "sm" },
      { "h-control text-label-16": size === "lg" },
    ]}
  >
    <IconHash class:list={["opacity-80", "size-4"]} />
    {tagName}
  </a>
</li>
