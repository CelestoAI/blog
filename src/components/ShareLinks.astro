---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="text-muted-foreground text-label-14">
        Share this post on:
      </span>
      <div class="flex items-center gap-1">
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href + URL}`}
            class="size-8 justify-center hover:text-accent"
            title={social.linkTitle}
          >
            <social.icon class="inline-block size-4 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
