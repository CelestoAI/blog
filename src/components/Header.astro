---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const base = `${SITE.basePath}/`;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { label: "Blog", href: base, active: currentPath === SITE.basePath },
  {
    label: "Posts",
    href: `${base}posts/`,
    active: currentPath.startsWith(`${base}posts`),
  },
  {
    label: "Tags",
    href: `${base}tags/`,
    active: currentPath.startsWith(`${base}tags`),
  },
  { label: "Docs ↗", href: "https://celesto.ai/docs", active: false },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-4 -top-full z-50 inline-flex h-control-sm items-center rounded-md border border-border bg-background px-3 text-button-14 focus:top-4"
  >Skip to content</a
>
<header class="site-header app-layout">
  <nav class="navbar" aria-label="Main navigation">
    <a href="https://celesto.ai" class="logo" aria-label="Celesto home">
      <img
        src="https://ik.imagekit.io/gradsflow/celestoai/logo/celesto-logo_KDV0f6bxO.svg"
        alt=""
        width="26"
        height="26"
      />
      <span>Celesto</span>
    </a>
    <div class="nav-actions">
      <a
        class="icon-button"
        href={`${base}search/`}
        aria-label="Search articles"
        title="Search articles"><IconSearch /></a
      >
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="icon-button theme-toggle"
            title="Toggle light and dark theme"
            aria-label="Toggle theme"
          >
            <IconMoon class="theme-moon" />
            <IconSunHigh class="theme-sun" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="icon-button menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconMenuDeep class="menu-open" /><IconX class="menu-close" />
      </button>
    </div>
    <div id="menu-items" class="nav-panel">
      <ul class="nav-links">
        {
          links.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={link.active ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav-cta" href="https://celesto.ai/dashboard"
        >Start free <span aria-hidden="true">↗</span></a
      >
    </div>
  </nav>
</header>

<style>
  .site-header {
    padding-top: 24px;
  }
  .navbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
    padding: 10px 16px 10px 22px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
  }
  .logo img {
    width: 26px;
    height: 26px;
  }
  .nav-panel {
    display: contents;
  }
  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-inline: auto;
    order: 1;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 14px;
    line-height: 20px;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
    transition:
      background 0.15s,
      color 0.15s;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    background: var(--muted);
    color: var(--foreground);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    order: 2;
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
  }
  @media (pointer: coarse) {
    .icon-button::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 44px;
      height: 44px;
      transform: translate(-50%, -50%);
    }
  }
  .icon-button:hover {
    background: var(--muted);
    color: var(--foreground);
  }
  .icon-button :global(svg) {
    width: 16px;
    height: 16px;
  }
  .theme-toggle {
    position: relative;
  }
  .theme-toggle :global(svg) {
    position: absolute;
  }
  .theme-toggle :global(.theme-sun) {
    display: none;
  }
  :global([data-theme="dark"]) .theme-toggle :global(.theme-moon) {
    display: none;
  }
  :global([data-theme="dark"]) .theme-toggle :global(.theme-sun) {
    display: block;
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-shrink: 0;
    order: 3;
    border: 1px solid var(--border);
    /* A pill bar holds pill actions: the radius follows the container's curve. */
    border-radius: 999px;
    height: 40px;
    padding: 0 16px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    background: var(--muted);
  }
  .nav-cta:hover {
    border-color: color-mix(in srgb, var(--foreground) 40%, transparent);
  }
  .menu-toggle {
    display: none;
  }
  .menu-close {
    display: none;
  }
  @media (max-width: 959px) {
    .site-header {
      padding-top: 12px;
    }
    .navbar {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0;
      min-height: 60px;
      padding: 8px 12px 8px 18px;
      border-radius: 26px;
    }
    .nav-actions {
      margin-left: auto;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .nav-panel {
      display: none;
      order: 3;
      flex-basis: 100%;
      padding: 14px 4px 8px;
      margin-top: 8px;
      border-top: 1px solid var(--border);
    }
    .navbar[data-open] .nav-panel {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .navbar[data-open] .menu-open {
      display: none;
    }
    .navbar[data-open] .menu-close {
      display: block;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      margin: 0;
      gap: 4px;
    }
    .nav-links a {
      height: 40px;
      padding: 0 16px;
      border-radius: 6px;
      font-size: 14px;
    }
    /* In the dropdown panel the CTA sits with the 6px menu rows. */
    .nav-cta {
      border-radius: 6px;
    }
  }
</style>

<script>
  function setupNavigation() {
    const navbar = document.querySelector<HTMLElement>(".navbar");
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (!navbar || !button || navbar.dataset.ready) return;
    navbar.dataset.ready = "true";
    const setOpen = (open: boolean) => {
      navbar.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    button.addEventListener("click", () =>
      setOpen(!navbar.hasAttribute("data-open"))
    );
    navbar.addEventListener("keydown", event => {
      if (event.key === "Escape" && navbar.hasAttribute("data-open")) {
        setOpen(false);
        button.focus();
      }
    });
    navbar.addEventListener("focusout", event => {
      if (!navbar.contains(event.relatedTarget as Node)) setOpen(false);
    });
    navbar.addEventListener("click", event => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    const closeOutside = (event: PointerEvent) => {
      if (!navbar.isConnected) {
        document.removeEventListener("pointerdown", closeOutside);
        return;
      }
      if (!navbar.contains(event.target as Node)) setOpen(false);
    };
    document.addEventListener("pointerdown", closeOutside);
  }
  document.addEventListener("astro:page-load", setupNavigation);
</script>
