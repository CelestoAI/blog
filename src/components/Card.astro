---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, ...props } = data;
---

<li class="post-card">
  <a
    href={`${getPath(id, filePath)}/`}
    class:list={[
      "inline-block rounded-sm text-label-18 font-medium focus-ring",
      "underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="post-meta">
    <Datetime {...props} class="post-date" />
    <span>{getReadingTime(body || "")} min read</span>
  </div>
  <p>{description}</p>
</li>
